# 本アプリは外部 API・外部認証の秘密を持たない。以下は変数名の一覧（値は書かない）。
#
# 秘密（Worker secret）: 本番は `npx wrangler secret put ADMIN_RESET_TOKEN` で設定する。
# ローカルは リポジトリ直下の .dev.vars（git 管理外）に同名で書く。
ADMIN_RESET_TOKEN=

# 設定値（wrangler.jsonc の vars。既定 production）。Cookie の Secure は常時有効で、これには依存しない。
APP_ENV=

# D1 の接続先は wrangler.jsonc の d1_databases（binding: DB）で指定する。
