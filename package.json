{
  "name": "electricity-plan-advisor-demo-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:frontend": "npm --prefix frontend run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build:frontend && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.131.1"
  }
}
